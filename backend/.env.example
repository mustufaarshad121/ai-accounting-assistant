# Backend environment (local development example only).
# Copy to .env (git-ignored) and adjust. NEVER commit real secrets or Supabase
# credentials. Values below are safe local Docker/dev placeholders.

# Pooled async connection used by the FastAPI app at runtime.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/accounting_assistant

# Direct (non-pooled) connection used by Alembic migrations.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accounting_assistant

# Origin allowed by CORS (the frontend).
FRONTEND_URL=http://localhost:3000

# Runtime environment name.
ENVIRONMENT=development
