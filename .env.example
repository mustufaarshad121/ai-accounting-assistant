# ------------------------------------------------------------------------------
# .env.example — placeholders ONLY. Never commit real credentials.
# Copy to .env (git-ignored) and fill in real values locally / in your host's
# environment settings. Server-only secrets must never be exposed to the browser.
# ------------------------------------------------------------------------------

# --- Database (Supabase PostgreSQL) ---
# Pooled connection string used by the running app.
DATABASE_URL=
# Direct (non-pooled) connection string used by Alembic migrations.
DIRECT_DATABASE_URL=

# --- Supabase project ---
SUPABASE_URL=
# Client-safe key (may be exposed to the browser).
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. NEVER expose to the frontend.
SUPABASE_SECRET_KEY=

# --- AI model (OpenAI-compatible endpoint) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- App wiring ---
# Backend CORS allowlist / frontend origin.
FRONTEND_URL=
# Base URL the Next.js frontend uses to reach the backend (exposed to browser).
NEXT_PUBLIC_API_URL=
# development | production
ENVIRONMENT=
